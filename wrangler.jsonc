{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appkkkkkkk",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3d0e5a3a-ad9e-427a-813b-1ca62d865258","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "272f6c6e0b884be3af4d0a054bf44303" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
